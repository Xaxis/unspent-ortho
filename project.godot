; Engine configuration file.
; Hand-edited on purpose: keep it small and readable.

config_version=5

[application]

config/name="UNSPENT"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Events="*res://src/events.gd"

[audio]

; The web default plays each sound as a browser sample, outside the mix: no bus
; filters, no meters, and the game's beds stayed silent. Mix it like everywhere else.
general/default_playback_type.web=0

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
; The window opens without taking the focus of whatever the person at the
; keyboard is doing: a hundred shots and tours a day must not interrupt them.
; A real play session takes its focus back in src/main.gd, where it can tell a
; player from a tool run.
window/size/no_focus=true
; And it opens ONE PIXEL across, in a far corner. macOS always clamps a window
; back onto some screen, so there is no off-screen to hide in — a position picked
; to be far away landed dead centre on a fourth monitor. A 1x1 window needs no
; luck: it is invisible on any arrangement of any number of displays, and the
; frame is unaffected, because the viewport renders 640x360 into its own texture
; whatever size the window is.
;
; The `.editor` suffix means this applies to every run made with the Godot binary
; — our tools, and the ad-hoc runs an agent writes for itself, which is the half
; no tool script can reach — and never to an exported build, which a player
; launches. src/main.gd gives the window its real size for a session a person
; means to play.
window/size/initial_position_type.editor=0
window/size/initial_position.editor=Vector2i(15599, 8639)
window/size/window_width_override.editor=1
window/size/window_height_override.editor=1

