[rendering]

; Forward+ is the target and Compatibility is the degradation path (docs/LOOK.md).
; The `.web` and `.mobile` overrides are feature-tag settings the exported build
; reads; a desktop run (and every tool run) takes the bare one. Verified in a real
; exported web build: the browser reports gl_compatibility, the desktop Forward+.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
; What follows is the `high` tier of src/render/quality.gd, which is the default
; a desktop run boots at. These were all pinned low for a 640x360 nearest image:
; msaa off because there was nothing to smooth at one screen pixel a texel, a
; small shadow map and no filtering because the shadow was three pixels wide.
; QualityTier.apply() overwrites each of these at boot, so a tier is the authority
; and these are only what the engine starts with before it runs.
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/atlas_size=4096
; The tier knob. `scaling_3d/scale` is a fraction of the 1920x1080 base that the
; 3D image is rendered at and then upscaled into; the UI is a canvas item and is
; never touched by it, so degrading costs sharpness in the world and nothing on
; the slate. Mode 0 is bilinear, 1 FSR1, 2 FSR2; every tier is on 0 for now and
; src/render/quality.gd says why. QualityTier.apply() overwrites both of these.
rendering/scaling_3d/mode=0
rendering/scaling_3d/scale=1.0
; The macOS export refuses arm64 without it; nothing here is an imported texture.
textures/vram_compression/import_etc2_astc=true

