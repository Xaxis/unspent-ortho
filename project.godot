[shader_globals]

sky_tint={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
sky_sun={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
sky_clouds={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
