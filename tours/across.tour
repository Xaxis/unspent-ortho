# --- 10 MENDED GEAR: what the Covenant lives on, for the plate he has spent --------------------
await goal:mend 5
shot 26-the-goal-is-the-mended-plate with goal:mend,goal_shown
# No bench at the camp: he puts one up, and the mend is an hour's work left going
# at it (Crafting.sets_going).
tap craft
await app:crafting 3
choose bench
tap use
await station:bench 8
wait 0.4
choose plate_mended
tap use
wait 0.4
tap craft
await app:none 3
await made:plate_mended 90
wait 0.6
shot 27-the-plate-mended-at-a-bench with station:bench

