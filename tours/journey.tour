# The journey north across seed 1: wake on the south coast, walk inland, then
# stand in each ecotone and walk across it, so the land can be seen turning.
#   tools/tour.sh tours/journey.tour --seed=1
# Coordinates come from `tools/map.sh --seed=1` (country and ecotone samples).
zoom 30
shot 01-spawn
walk 0,-1 2.5 run
shot 02-inland
# coast into moss (asked for by name: the old 307,355 is coast heartland now)
place coast-moss
shot 03-coast-moss with border:coast-moss
walk 0,-1 2.5 run
shot 04-coast-moss-walked with land:coast|moss
# moss into pinewood
place moss-pinewood
shot 05-moss-pinewood with border:moss-pinewood
walk 1,-1 2.5 run
shot 06-moss-pinewood-walked with land:moss|pinewood
# pinewood up onto the snow
place pinewood-snowfield
shot 07-pinewood-snowfield with border:pinewood-snowfield
walk 0,-1 2.5 run
shot 08-pinewood-snowfield-walked with land:pinewood|snowfield
# bonelands to the rim of the burning
place bonelands-burning
shot 09-bonelands-burning with border:bonelands-burning
walk -1,-1 2.5 run
shot 10-bonelands-burning-walked with land:bonelands|burning
# a fumarole field out on the Burning's slopes
at 207,145
shot 11-fumarole with land:burning
# the caldera
at 134,142
zoom 44
shot 12-caldera with land:burning
