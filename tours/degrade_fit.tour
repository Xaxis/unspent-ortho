# The fit behind CompatTrim (src/render/degrade/compat_trim.gd): the Compatibility
# renderer's frame held against the desktop's frame of the same moment, and every
# number the web's light is counted back by walked, one at a time and three times
# round, to where the two differ least (`perf match`, render_probe.gd). The first
# part is tours/canon.tour line for line with each `shot` replaced by a fit, so
# the desktop frames it reads are that tour's own; the second is
# tours/degrade_grey.tour, the same for an overcast that takes the sun's shadow
# away. Average the rows it prints by day and by night, casting and not, and those
# are CompatTrim's four rows:
#   tools/canon.sh --web                       (desktop frames -> shots/degrade/desktop/)
#   tools/tour.sh tours/degrade_grey.tour --seed=7 && cp -R shots/tour/degrade_grey shots/degrade/desktop-grey
#   godot --path . --rendering-method gl_compatibility -- --tour=tours/degrade_fit.tour --seed=7 --quality=web
# Desktop gl_compatibility and the exported web build measured identical on every
# probe (`perf sunpath`, `perf shadowpass`), and a fit wants thousands of frames,
# so it runs on the desktop's Compatibility; tools/canon.sh --web is the proof in
# the browser. It shoots nothing: the evidence is the printed rows.
weather clear:0
place spawn
wait 0.8
perf match shots/degrade/desktop/01-spawn-morning.png
place coast
wait 0.8
perf match shots/degrade/desktop/02-coast.png
place moss
wait 0.8
perf match shots/degrade/desktop/03-moss.png
place pinewood
wait 0.8
perf match shots/degrade/desktop/04-pinewood.png
place snowfield
wait 0.8
perf match shots/degrade/desktop/05-snowfield.png
place bonelands
wait 0.8
perf match shots/degrade/desktop/06-bonelands.png
place burning
wait 0.8
perf match shots/degrade/desktop/07-burning.png
place coast-pinewood
wait 0.8
perf match shots/degrade/desktop/08-eco-coast-pinewood.png
place pinewood-snowfield
wait 0.8
perf match shots/degrade/desktop/09-eco-pinewood-snowfield.png
place bonelands-burning
wait 0.8
perf match shots/degrade/desktop/10-eco-bonelands-burning.png
place coast-moss
wait 0.8
perf match shots/degrade/desktop/11-eco-coast-moss.png
place spawn
wait 0.8
hour 19.5
wait 0.4
perf match shots/degrade/desktop/12-spawn-dusk.png
hour 23
wait 0.4
perf match shots/degrade/desktop/13-spawn-night.png
tap lamp
wait 0.4
perf match shots/degrade/desktop/14-night-lamp.png
hour 12
place snowfield
wait 0.8
wait 0.3
perf match shots/degrade/desktop/15-snowfield-noon.png
place burning
wait 0.8
hour 20
wait 0.3
perf match shots/degrade/desktop/16-burning-dusk.png

# The two things the canon never showed: wet ground mirroring light, and the
# stolen neon somebody wired into a house. The neon frame goes to the landmark
# where a shack wired the machines' light into its wall (GenWorks records it, and
# `place` fails if the world has none), and then asks the picture itself whether
# a tube is in it: the frame used to be shot at the spawn village, where the
# canon seed has no neon shack at all, so the reference for "stolen neon" held
# none of the three tube colours and could not have caught a regression in them.
place spawn
wait 0.8
hour 22
# Thin rain here too, for the reason frame 18 gives: at rain:1 the streaks
# alone walked two runs 1.9-2.25 apart against the sheet's tolerance of 3.
weather rain:0.45
wait 1.2
perf match shots/degrade/desktop/17-village-wet-night.png
# Thin rain, not a downpour: the ground still mirrors the tube, and the frame
# stops moving. At rain:1 and this zoom the streaks alone walked two runs 2.9
# apart, against the sheet's tolerance of 3 -- a reference frame one bad roll
# from crying regression.
place stolen_light
weather rain:0.45
zoom 9
wait 1.2
walk 0,1 1.2
wait 0.6
perf match shots/degrade/desktop/18-stolen-neon-close.png
zoom 14
weather clear:0

# An overcast: the sun does not cast, so no second pass (CompatTrim OPEN_*).
weather grey:1
place spawn
hour 12
wait 0.8
perf match shots/degrade/desktop-grey/g1-spawn-grey-noon.png
place moss
wait 0.8
perf match shots/degrade/desktop-grey/g2-moss-grey.png
place snowfield
wait 0.8
perf match shots/degrade/desktop-grey/g3-snowfield-grey.png
place spawn
hour 23
wait 0.8
perf match shots/degrade/desktop-grey/g4-spawn-grey-night.png
tap lamp
wait 0.4
perf match shots/degrade/desktop-grey/g5-grey-night-lamp.png
